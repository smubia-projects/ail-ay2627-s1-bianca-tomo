# TOMO backend (Cloud Run). Copy to .env, fill in, then upload it as the repo's DOTENV secret:
#   gh secret set DOTENV --repo smubia-projects/ail-ay2627-s1-bianca-tomo < .env
# Placeholders only: never commit real values.

# ---- Website -> API ----
# The website's address(es), comma-separated, no trailing slash. Unset = http://localhost:5173 (local Vite dev server).
CORS_ORIGINS=https://ail-ay2627-s1-bianca-tomo.vercel.app

# ---- Database: Neon Postgres (required in production) ----
# An empty database is enough: the tables are created automatically at start-up. Use the pooled connection string.
# Leave empty locally to use a SQLite file (backend/data/local.db).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---- AI: OpenRouter (required) ----
API_KEY=
# Text: lessons, quizzes, grading, chat (apiyi model ids)
MODEL_NAME=gemini-3.1-flash-lite
FALLBACK_MODEL_NAME=gemini-3.5-flash-lite
# Listening to voice notes (must accept audio input; gemini-3.1-flash-lite does not)
AUDIO_MODEL_NAME=gemini-3.5-flash-lite
AUDIO_FALLBACK_MODEL_NAME=gemini-3.5-flash-lite
# Speech for phrases, dialogues and listening questions needs an audio-output model; apiyi has none, so it is unset
# and listening questions show the line behind a spoiler instead.
# TTS_MODEL_NAME=
TTS_VOICE=alloy
# The student's original free voices (Edge read-aloud + Google Translate TTS) are unofficial endpoints: off by default.
UNOFFICIAL_TTS_ENABLED=false

# ---- Telegram bot (webhook mode, required) ----
# The club's own bot from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Optional: skips one getMe lookup (the bot's @username without the @)
TELEGRAM_BOT_USERNAME=
# Any long random string; Telegram sends it in the X-Telegram-Bot-Api-Secret-Token header on every update.
TELEGRAM_WEBHOOK_SECRET=
# This service's URL + /api/telegram. Registered with Telegram automatically at start-up.
WEBHOOK_URL=https://ail-ay2627-s1-bianca-tomo-464725632804.asia-southeast3.run.app/api/telegram

# ---- Rate limiting: shared AI Lodge engine (Upstash Redis) ----
# Without these, rate limiting is off (fine for local development).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Fallback limits per window (the central sheet overrides them at runtime)
# plan: plan builds per visitor IP; session: lessons/quizzes per Telegram user; reply: AI-checked answers, voice notes and tutor replies per Telegram user
RATE_LIMIT_PLAN_MAX=5
RATE_LIMIT_SESSION_MAX=15
RATE_LIMIT_REPLY_MAX=60
RATE_LIMIT_WINDOW_SECONDS=432000

# ---- Spending guard (whole site, per day) ----
# Stops the AI for the day once the estimated spend reaches this (USD). 0 = no cap.
DAILY_BUDGET_USD=5
# Used for the estimate (USD per million tokens); keep them at or above the models' real prices.
PRICE_IN_PER_M=0.30
PRICE_OUT_PER_M=2.50

# ---- Optional: the private Breaking Into Wall Street guide (see DEPLOY.md) ----
# Copyrighted third-party material: leave empty on the club deployment unless the rights are confirmed.
BIWS_ACCESS_CODE=

# Do not set PORT here: Cloud Run sets it (and refuses it in --env-vars-file). Locally the API runs on 5050.
